<% layout("layouts/boilerplate.ejs") %>
<main class="unavailable-page">
  <div class="unavailable-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg></div>
  <p class="eyebrow">Almost there</p>
  <h1>Reservations are coming soon</h1>
  <% if (reservation) { %>
    <p>Your trip request is ready. Online reservations are not available just yet, but these are the details you selected:</p>
    <div class="reservation-review">
      <div><span>Check-in</span><strong><%= reservation.checkIn %></strong></div>
      <div><span>Checkout</span><strong><%= reservation.checkOut %></strong></div>
      <div><span>Guests</span><strong><%= reservation.guests %></strong></div>
      <div><span>Nights</span><strong><%= reservation.nights %></strong></div>
    </div>
  <% } else { %>
    <p>Online reservations are not available just yet. You can keep exploring this stay and check back soon.</p>
  <% } %>
  <div class="unavailable-actions"><a class="button" href="/listing/<%= listingId %>">Back to the listing</a><a class="secondary-button" href="/listing">Explore other stays</a></div>
</main>
